<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Бүтцийн хувилбарын жагсаалт -->

    <record id="view_hdc_hr_structure_list" model="ir.ui.view">
        <field name="name">hdc.hr.structure.list</field>
        <field name="model">hdc.hr.structure</field>
        <field name="arch" type="xml">

            <list string="Бүтцийн хувилбарууд"
                  decoration-success="state == 'active'"
                  decoration-muted="state == 'closed'">

                <field name="name"/>
                <field name="code"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="node_count"/>
                <field name="state"/>

            </list>

        </field>
    </record>


    <!-- Бүтцийн хувилбарын form -->

    <record id="view_hdc_hr_structure_form" model="ir.ui.view">
        <field name="name">hdc.hr.structure.form</field>
        <field name="model">hdc.hr.structure</field>

        <field name="arch" type="xml">

            <form string="Бүтцийн хувилбар">

                <header>

                    <button name="action_generate_from_departments"
                            string="Department-оос бүтэц үүсгэх"
                            type="object"
                            class="btn-secondary"
                            icon="fa-sitemap"/>

                    <button name="action_activate"
                            string="Бүтцийг идэвхжүүлэх"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'active'"/>

                    <button name="action_set_draft"
                            string="Ноорог болгох"
                            type="object"
                            invisible="state == 'draft'"/>

                    <button name="action_close"
                            string="Хаах"
                            type="object"
                            invisible="state == 'closed'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,active,closed"/>

                </header>


                <sheet>

                    <div class="oe_title">

                        <label for="name"/>

                        <h1>
                            <field name="name"
                                   placeholder="Жишээ: ХДК бүтэц 2026"/>
                        </h1>

                    </div>


                    <group>

                        <group>
                            <field name="code"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>

                        <group>
                            <field name="node_count" readonly="1"/>
                            <field name="active"/>
                        </group>

                    </group>


                    <notebook>

                        <page string="Бүтцийн нэгжүүд">

                            <field name="node_ids"
                                   context="{'default_structure_id': id}">

                                <list editable="bottom">

                                    <field name="sequence"
                                           widget="handle"/>

                                    <field name="code"/>

                                    <field name="name"/>

                                    <field name="node_type"/>

                                    <field name="parent_id"/>

                                    <field name="department_id"/>

                                    <field name="job_id"/>

                                </list>

                            </field>

                        </page>


                        <page string="Тайлбар">
                            <field name="note"
                                   placeholder="Бүтцийн өөрчлөлтийн тайлбар..."/>
                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <record id="action_hdc_hr_structure" model="ir.actions.act_window">
        <field name="name">Бүтцийн тохиргоо</field>
        <field name="res_model">hdc.hr.structure</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_hdc_hr_structure_setup" model="ir.actions.act_window">
        <field name="name">Бүтцийн тохиргоо</field>
        <field name="res_model">hdc.hr.structure</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Байгууллагын бүтцийн хувилбар үүсгэнэ үү.</p>
            <p>Шинэ хувилбар үүсгээд "Department-оос бүтэц үүсгэх", дараа нь "Бүтцийг идэвхжүүлэх" товчийг дарна.</p>
        </field>
    </record>

</odoo>