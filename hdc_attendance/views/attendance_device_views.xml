<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hdc_attendance_device_list"
            model="ir.ui.view">

        <field name="name">hdc.attendance.device.list</field>
        <field name="model">hdc.attendance.device</field>

        <field name="arch" type="xml">

            <list string="Ирцийн төхөөрөмжүүд">

                <field name="name"/>
                <field name="serial_number"/>
                <field name="device_model"/>
                <field name="ip_address"/>
                <field name="location"/>
                <field name="protocol"/>
                <field name="last_seen"/>
                <field name="last_ip"/>
                <field name="active"/>

            </list>

        </field>

    </record>


    <record id="view_hdc_attendance_device_form"
            model="ir.ui.view">

        <field name="name">hdc.attendance.device.form</field>
        <field name="model">hdc.attendance.device</field>

        <field name="arch" type="xml">

            <form string="Ирцийн төхөөрөмж">

                <header>

                    <button
                        name="action_open_pull_wizard"
                        string="Ирц татах"
                        type="object"
                        class="btn-primary"
                        icon="fa-download"
                    />

                </header>

                <group string="TCP холболт">

                    <field name="ip_address"/>

                    <field name="port"/>

                    <field name="comm_key"
                        password="True"/>

                </group>
                <sheet>

                    <div class="oe_button_box"
                         name="button_box">

                        <button
                            name="action_view_raw_logs"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list">

                            <field
                                name="log_count"
                                widget="statinfo"
                                string="Raw Logs"/>

                        </button>

                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group string="Төхөөрөмж">
                            <field name="serial_number"/>
                            <field name="device_model"/>
                            <field name="location"/>
                            <field name="active"/>
                        </group>

                        <group string="Холболт">
                            <field name="protocol"/>
                            <field name="ip_address"/>
                            <field name="last_ip" readonly="1"/>
                            <field name="last_seen" readonly="1"/>
                        </group>

                    </group>

                    <group>
                        <field name="note"/>
                    </group>

                </sheet>

                <chatter/>

            </form>

        </field>

    </record>


    <record id="action_hdc_attendance_device"
            model="ir.actions.act_window">

        <field name="name">Ирцийн төхөөрөмжүүд</field>
        <field name="res_model">hdc.attendance.device</field>
        <field name="view_mode">list,form</field>

    </record>

</odoo>
