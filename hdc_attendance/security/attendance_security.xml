<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_hdc_attendance"
            model="ir.module.category">
        <field name="name">HDC Attendance</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_hdc_attendance_user"
            model="res.groups">
        <field name="name">Ирцийн хэрэглэгч</field>
        <field name="category_id"
               ref="module_category_hdc_attendance"/>
    </record>

    <record id="group_hdc_attendance_manager"
            model="res.groups">
        <field name="name">Ирцийн админ</field>
        <field name="category_id"
               ref="module_category_hdc_attendance"/>
        <field name="implied_ids"
               eval="[(4, ref('group_hdc_attendance_user'))]"/>
    </record>

</odoo>
