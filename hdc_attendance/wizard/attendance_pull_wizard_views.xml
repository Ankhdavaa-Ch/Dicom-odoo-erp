<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================ -->
    <!-- PULL ATTENDANCE WIZARD FORM -->
    <!-- ================================================ -->

    <record id="view_hdc_attendance_pull_wizard_form"
            model="ir.ui.view">

        <field name="name">hdc.attendance.pull.wizard.form</field>
        <field name="model">hdc.attendance.pull.wizard</field>

        <field name="arch" type="xml">

            <form string="Ирц төхөөрөмжөөс татах">

                <group>

                    <field name="device_id"/>

                    <field name="date_from"/>

                    <field name="date_to"/>

                </group>

                <footer>

                    <button
                        name="action_pull_logs"
                        string="Ирц татах"
                        type="object"
                        class="btn-primary"
                        icon="fa-download"
                    />

                    <button
                        string="Болих"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>

    </record>


    <!-- ================================================ -->
    <!-- OPEN WIZARD ACTION -->
    <!-- ================================================ -->

    <record id="action_hdc_attendance_pull_wizard"
            model="ir.actions.act_window">

        <field name="name">Ирц төхөөрөмжөөс татах</field>

        <field name="res_model">
            hdc.attendance.pull.wizard
        </field>

        <field name="view_mode">form</field>

        <field name="target">new</field>

    </record>

</odoo>