<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hdc_roles" model="ir.module.category">
        <field name="name">ХДК ERP дүр</field>
        <field name="description">ХДК ERP системийн хэрэглэгчийн дүрүүд</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_hdc_basic_user" model="res.groups">
        <field name="name">Энгийн хэрэглэгч</field>
        <field name="category_id" ref="module_category_hdc_roles"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_hdc_hr_user" model="res.groups">
        <field name="name">Хүний нөөцийн хэрэглэгч</field>
        <field name="category_id" ref="module_category_hdc_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_hdc_basic_user')), (4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_hdc_hr_manager" model="res.groups">
        <field name="name">Хүний нөөцийн админ</field>
        <field name="category_id" ref="module_category_hdc_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_hdc_hr_user')), (4, ref('hr.group_hr_manager'))]"/>
    </record>

    <record id="group_hdc_attendance_user" model="res.groups">
        <field name="name">Ирцийн хэрэглэгч</field>
        <field name="category_id" ref="module_category_hdc_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_hdc_basic_user')), (4, ref('hdc_attendance.group_hdc_attendance_user'))]"/>
    </record>

    <record id="group_hdc_attendance_manager" model="res.groups">
        <field name="name">Ирцийн админ</field>
        <field name="category_id" ref="module_category_hdc_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_hdc_attendance_user')), (4, ref('hdc_attendance.group_hdc_attendance_manager'))]"/>
    </record>

    <record id="group_hdc_system_admin" model="res.groups">
        <field name="name">Системийн админ</field>
        <field name="category_id" ref="module_category_hdc_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_hdc_hr_manager')), (4, ref('group_hdc_attendance_manager')), (4, ref('base.group_system'))]"/>
    </record>
</odoo>
