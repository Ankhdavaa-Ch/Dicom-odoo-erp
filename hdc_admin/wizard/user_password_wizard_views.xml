<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hdc_user_password_wizard_form" model="ir.ui.view">
        <field name="name">hdc.user.password.wizard.form</field>
        <field name="model">hdc.user.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Нууц үг тохируулах">
                <group>
                    <field name="user_id"/>
                    <field name="login"/>
                </group>
                <group string="Шинэ нууц үг">
                    <field name="password" password="True" placeholder="Хамгийн багадаа 8 тэмдэгт"/>
                    <field name="password_confirm" password="True" placeholder="Нууц үгээ дахин оруулна уу"/>
                </group>
                <footer>
                    <button name="action_set_password" string="Нууц үг тохируулах" type="object" class="btn-primary"/>
                    <button string="Болих" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hdc_user_password_wizard" model="ir.actions.act_window">
        <field name="name">Нууц үг тохируулах</field>
        <field name="res_model">hdc.user.password.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hdc_user_password_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_user_id': active_id}</field>
    </record>
</odoo>
