<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_hdc_roles" model="ir.ui.view">
        <field name="name">res.users.form.hdc.roles</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login']" position="after">
                <field name="hdc_role_ids"
                       string="Системийн дүр"
                       widget="many2many_tags"
                       options="{'no_create': True, 'no_create_edit': True}"
                       groups="base.group_system"/>
            </xpath>
        </field>
    </record>

    <record id="view_hdc_system_users_list" model="ir.ui.view">
        <field name="name">res.users.hdc.system.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Системийн хэрэглэгч">
                <field name="name"/>
                <field name="login"/>
                <field name="email"/>
                <field name="hdc_role_ids" string="Системийн дүр" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hdc_system_users_form" model="ir.ui.view">
        <field name="name">res.users.hdc.system.form</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="Системийн хэрэглэгч">
                <header>
                    <button name="%(hdc_admin.action_hdc_user_password_wizard)d"
                            string="Нууц үг тохируулах"
                            type="action"
                            class="btn-primary"
                            groups="base.group_system"
                            invisible="not id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Идэвхгүй" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Овог нэр"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Ерөнхий мэдээлэл">
                            <field name="login" string="Нэвтрэх нэр"/>
                            <field name="email" string="И-мэйл"/>
                            <field name="phone" string="Утас"/>
                            <field name="company_id" string="Компани" groups="base.group_multi_company"/>
                            <field name="active" string="Идэвхтэй"/>
                        </group>
                        <group string="Системийн эрх">
                            <field name="hdc_role_ids"
                                   string="Системийн дүр"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                    <separator string="Нууц үгийн удирдлага"/>
                    <div class="text-muted">
                        Системийн админ дээрх “Нууц үг тохируулах” товчоор хэрэглэгчийн анхны болон шинэ нууц үгийг тохируулна.
                        Нууц үг ил текстээр хадгалагдахгүй, Odoo-ийн стандарт хамгаалалт ашиглагдана.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
