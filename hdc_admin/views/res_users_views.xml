<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hdc_system_users_list" model="ir.ui.view">
        <field name="name">res.users.hdc.system.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Системийн хэрэглэгч">
                <field name="hdc_employee_id" string="Ажилтан"/>
                <field name="login" string="Нэвтрэх нэр"/>
                <field name="hdc_role_id" string="Системийн дүр"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hdc_system_users_form" model="ir.ui.view">
        <field name="name">res.users.hdc.system.form</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="Системийн хэрэглэгч">
                <header>
                    <button name="%(hdc_admin.action_hdc_user_password_wizard)d"
                            string="Нууц үг тохируулах"
                            type="action"
                            class="btn-primary"
                            groups="base.group_system"
                            invisible="not id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Идэвхгүй" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="hdc_role_category_id" invisible="1"/>

                    <div class="oe_title">
                        <label for="hdc_employee_id" string="Ажилтан"/>
                        <h1>
                            <field name="hdc_employee_id"
                                   placeholder="Ажилтан сонгоно уу"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Ерөнхий мэдээлэл">
                            <field name="name" string="Нэр" readonly="hdc_employee_id"/>
                            <field name="login" string="Нэвтрэх нэр"/>
                            <field name="email" string="И-мэйл"/>
                            <field name="phone" string="Утас"/>
                            <field name="company_id" string="Компани" groups="base.group_multi_company"/>
                            <field name="active" string="Идэвхтэй"/>
                        </group>
                        <group string="Системийн эрх">
                            <field name="hdc_role_id"
                                   string="Системийн дүр"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <div class="text-muted">
                                Модулийн эрхүүд сонгосон системийн дүрээс автоматаар өвлөгдөнө.
                            </div>
                        </group>
                    </group>

                    <separator string="Нууц үгийн удирдлага"/>
                    <div class="text-muted">
                        Системийн админ “Нууц үг тохируулах” товчоор хэрэглэгчийн анхны болон шинэ нууц үгийг тохируулна.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
