<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_hdc_system_users" model="ir.actions.act_window">
        <field name="name">Системийн хэрэглэгч</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_hdc_system_groups" model="ir.actions.act_window">
        <field name="name">Системийн дүр</field>
        <field name="res_model">res.groups</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hdc_login_log_list" model="ir.ui.view">
        <field name="name">hdc.login.log.list</field>
        <field name="model">hdc.login.log</field>
        <field name="arch" type="xml">
            <list string="Нэвтэрсэн лог" create="0" edit="0" delete="0">
                <field name="login_at"/>
                <field name="user_id"/>
                <field name="login"/>
                <field name="ip_address"/>
                <field name="user_agent"/>
            </list>
        </field>
    </record>

    <record id="view_hdc_login_log_search" model="ir.ui.view">
        <field name="name">hdc.login.log.search</field>
        <field name="model">hdc.login.log</field>
        <field name="arch" type="xml">
            <search string="Нэвтэрсэн лог">
                <field name="user_id"/>
                <field name="login"/>
                <field name="ip_address"/>
                <field name="login_at"/>
                <group expand="0" string="Бүлэглэх">
                    <filter string="Хэрэглэгч" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Өдөр" name="group_day" context="{'group_by': 'login_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hdc_login_log" model="ir.actions.act_window">
        <field name="name">Нэвтэрсэн лог</field>
        <field name="res_model">hdc.login.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_hdc_login_log_search"/>
    </record>
</odoo>
