<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_hdc_employee_request_user" model="ir.rule">
        <field name="name">Ажилтан өөрийн, удирдлага харьяа нэгжийн хүсэлтийг харна</field>
        <field name="model_id" ref="model_hdc_employee_request"/>
        <field name="domain_force">['|', '|', ('employee_id.user_id', '=', user.id), ('approver_user_id', '=', user.id), ('department_id', 'child_of', user.employee_id.department_id.id)]</field>
        <field name="groups" eval="[(4, ref('hdc_employee_service.group_hdc_employee_service_user'))]"/>
    </record>

    <record id="rule_hdc_employee_request_system_admin" model="ir.rule">
        <field name="name">Системийн админ бүх хүсэлтийг харна</field>
        <field name="model_id" ref="model_hdc_employee_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
