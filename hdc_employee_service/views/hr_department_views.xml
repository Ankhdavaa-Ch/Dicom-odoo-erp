<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_department_hdc_request_approver" model="ir.ui.view">
        <field name="name">hr.department.hdc.request.approver</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='manager_id']" position="after">
                <field name="hdc_approver_user_id" string="Нэгжийн удирдлага"/>
            </xpath>
        </field>
    </record>
</odoo>
